## Render the canonical ASCII inventory without a host-language data dependency.
Vocabulary := [].{
	Tables : { html : List(Str), svg : List(Str), mathml : List(Str), aria : List(Str) }
	after = |a, b| {
		var $index = 0
		while $index < a.len() and $index < b.len() {
			x = a.get($index) ?? 0.U8
			y = b.get($index) ?? 0.U8
			if x != y {
				return x > y
			}
			$index = $index + 1
		}
		a.len() > b.len()
	}
	validate : List(Str) -> Bool
	validate = |names| {
		if names.is_empty() {
			return False
		}
		var $previous = ""
		for name in names {
			bytes = name.to_utf8()
			letter = |byte| (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
			first = bytes.first() ?? 0
			if !letter(first) or bytes.any(|byte| !letter(byte) and !(byte >= 48 and byte <= 57) and byte != 45) or !after(bytes, $previous.to_utf8()) {
				return False
			}
			$previous = name
		}
		True
	}
	render : Tables -> Try(Str, [InvalidVocabulary(Str)])
	render = |tables| {
		var $text = "# Generated by scripts/generate.roc from scripts/markup/vocabulary.json.\n# Edit that canonical table and regenerate; membership stays a match expression.\nMarkupNameTables :: [].{\n"
		for (name, names) in [("html", tables.html), ("svg", tables.svg), ("mathml", tables.mathml), ("aria", tables.aria)] {
			if !validate(names) {
				return Err(InvalidVocabulary(name))
			}
			quoted = names.map(Json.to_str)
			$text = "${$text}\t${name}_names : List(Str)\n\t${name}_names = [${Str.join_with(quoted, ", ")}]\n\t${name}_name : Str -> Bool\n\t${name}_name = |name| match name {\n\t\t${Str.join_with(quoted, " | ")} => True\n\t\t_ => False\n\t}\n"
		}
		Ok("${$text}}\n")
	}
}
expect !Vocabulary.validate([])
expect !Vocabulary.validate(["span", "div"])
expect !Vocabulary.validate(["div", "div"])
expect {
	var $valid = True
	for n in List.repeat({}, 2000).map_with_index(|_, index| index) {
		name = "Element-${n.to_str()}"
		$valid = $valid and Vocabulary.validate([name]) and !Vocabulary.validate(["${name}é"]) and !Vocabulary.validate(["${name}/"])
	}
	$valid
}
