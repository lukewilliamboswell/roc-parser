    {
      "id": "document-full-footnotes-sequence",
      "category": "document-state",
      "support": "full",
      "source": "One footnote:[First].\n\nTwo footnote:[Second].",
      "expect": {
        "html_contains": [
          "id=\"_footnotedef_1\"",
          "id=\"_footnotedef_2\""
        ]
      }
    },
    {
      "id": "document-full-footnotes-list",
      "category": "document-state",
