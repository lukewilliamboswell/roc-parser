  "cases": [
    {
      "id": "table-nested-nested-table",
      "category": "tables-nesting-spans-separators",
      "features": [
        "nested-table"
      ],
      "source": "[cols=\"a\"]\n|===\n|Before\n\n!===\n!A !B\n!C !D\n!===\n|===",
      "support": "future",
      "expect": {
        "contexts": [
          "table"
        ],
        "html_contains": [
          "<p>Before</p>",
          "width: 50%;",
          ">D</p>"
        ]
      },
      "references": [
        "https://docs.asciidoctor.org/asciidoc/latest/tables/"
      ]
    },
