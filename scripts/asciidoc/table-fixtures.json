{
  "schema_version": 1,
  "oracle_version": "2.0.23",
  "provenance": {
    "authorship": "Original feature-composition inputs, semantic predicates authored independently of parser output.",
    "reference": "Asciidoctor 2.0 table grammar and HTML5 conversion"
  },
  "coverage": [
    {
      "category": "tables-extended",
      "required_cases": [
        "table-extended-noheader",
        "table-extended-footer",
        "table-extended-weighted",
        "table-extended-repeat",
        "table-extended-align",
        "table-extended-valign",
        "table-extended-strong",
        "table-extended-emphasis",
        "table-extended-mono",
        "table-extended-header-style",
        "table-extended-literal",
        "table-extended-unrecognized-style",
        "table-extended-cell-style",
        "table-extended-rowspan",
        "table-extended-span-both",
        "table-extended-csv-quotes",
        "table-extended-csv-multiline",
        "table-extended-dsv",
        "table-extended-separator",
        "table-extended-title",
        "table-extended-id-role",
        "table-extended-width",
        "table-extended-autowidth",
        "table-extended-frame-grid",
        "table-extended-nested-block",
        "table-extended-unicode",
        "table-extended-paragraphs",
        "table-extended-escaped-multiple"
      ]
    }
  ],
  "cases": [
    {
      "id": "table-extended-noheader",
      "category": "tables-extended",
      "support": "future",
      "source": "[options=noheader]\n|===\n|A |B\n\n|C |D\n|===",
      "expect": {
        "contexts": [
          "table"
        ],
        "html_contains": [
          "<tbody>"
        ],
        "html_excludes": [
          "<thead>"
        ]
      }
    },
    {
      "id": "table-extended-footer",
      "category": "tables-extended",
      "support": "future",
      "source": "[cols=\"1,1\",options=\"header,footer\"]\n|===\n|Name |Value\n|A |1\n|Total |1\n|===",
      "expect": {
        "contexts": [
          "table"
        ],
        "html_contains": [
          "<thead>",
          "<tfoot>"
        ],
        "html_excludes": []
      }
    },
