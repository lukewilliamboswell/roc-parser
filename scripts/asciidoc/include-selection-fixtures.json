      ],
      "source": "----\ninclude::part.adoc[tags=x;y]\n----",
      "includes": {
        "part.adoc": "// tag::y[]\na\n// tag::x[]\nb\n// end::y[]\nc\n// end::x[]\nd"
      },
      "support": "full",
