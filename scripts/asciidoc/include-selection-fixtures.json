    {
      "id": "include-selection-unexpected-end",
      "category": "include-selection",
      "features": [
        "UnmatchedEnd",
        "MissingTag",
        "EmptySelection"
      ],
      "source": "----\ninclude::part.adoc[tag=x]\n----",
      "includes": {
        "part.adoc": "a\n// end::x[]\nb"
      },
      "support": "full",
      "expect": {
        "contexts": [
          "listing"
        ],
        "html_contains": [
          "<pre></pre>"
        ],
        "warning_severities": [
          "WARN",
          "WARN"
        ],
        "warnings_contains": [
          "unexpected end tag 'x'",
          "tag 'x' not found"
        ]
      },
      "references": [
        "https://docs.asciidoctor.org/asciidoc/latest/directives/include-tagged-regions/"
      ]
    },
    {
      "id": "include-selection-mismatched-end",
