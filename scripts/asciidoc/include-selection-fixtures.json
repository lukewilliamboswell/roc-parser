      "features": [
        "UnclosedTag"
      ],
      "source": "----\ninclude::part.adoc[tag=x]\n----",
      "includes": {
        "part.adoc": "a\n// tag::x[]\nb\n"
      },
      "support": "full",
      "expect": {
        "contexts": [
          "listing"
        ],
        "html_contains": [
          "<pre>b</pre>"
        ],
        "warning_severities": [
          "WARN"
        ],
        "warnings_contains": [
          "detected unclosed tag 'x'"
        ]
      },
      "references": [
        "https://docs.asciidoctor.org/asciidoc/latest/directives/include-tagged-regions/"
      ]
    },
    {
      "id": "include-selection-reopened-unclosed-tag",
