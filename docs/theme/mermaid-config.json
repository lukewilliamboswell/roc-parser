{
  "theme": "base",
  "themeVariables": {
    "background": "transparent",
    "fontFamily": "Plus Jakarta Sans, Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#F4EFF8",
    "primaryTextColor": "#1A1A1A",
    "primaryBorderColor": "#6B3F8F",
    "secondaryColor": "#F4F4F2",
    "secondaryBorderColor": "#C8C8C4",
    "tertiaryColor": "#FFFFFF",
    "tertiaryBorderColor": "#C8C8C4",
    "lineColor": "#6B3F8F",
    "textColor": "#3A3A3A",
    "nodeBorder": "#6B3F8F",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#C8C8C4",
    "edgeLabelBackground": "#FFFFFF",
    "titleColor": "#1A1A1A",
    "actorBkg": "#F4EFF8",
    "actorBorder": "#6B3F8F",
    "actorTextColor": "#1A1A1A",
    "actorLineColor": "#C2AED6",
    "signalColor": "#3A3A3A",
    "signalTextColor": "#1A1A1A",
    "labelBoxBkgColor": "#FFFFFF",
    "labelBoxBorderColor": "#C8C8C4",
    "labelTextColor": "#1A1A1A",
    "loopTextColor": "#3A3A3A",
    "noteBkgColor": "#FFF8E1",
    "noteBorderColor": "#D9C27A",
    "noteTextColor": "#1A1A1A"
  },
  "themeCSS": "text.messageText, text.loopText, text.loopText tspan { paint-order: stroke !important; stroke: #FAFAF7 !important; stroke-width: 10px !important; stroke-linejoin: round !important; }",
  "sequence": {
    "wrap": true,
    "width": 170,
    "actorMargin": 70,
    "messageMargin": 42,
    "noteMargin": 14,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "mirrorActors": true,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "actorFontSize": 15
  },
  "flowchart": {
    "htmlLabels": false,
    "padding": 14,
    "nodeSpacing": 40,
    "rankSpacing": 48
  }
}
