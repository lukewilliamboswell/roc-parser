## Structured HTML tokenizer and tree-construction parse problems.
## These describe syntax/recovery independently of vocabulary/value validation.
MarkupHtmlError :: [].{

	## Parse error classification, with offending names where applicable.
	Code : [EofInProcessingInstruction, InvalidFirstCharacterOfProcessingInstructionTarget, InvalidProcessingInstructionTarget, DisallowedProcessingInstructionTarget, UnexpectedNull, EofInTag, EofInComment, IncorrectComment, BogusComment, InvalidTagOpen, DuplicateAttribute(Str), MissingAttributeValue, MissingWhitespace, InvalidAttributeCharacter, EndTagAttributes, InvalidSolidus, MissingSemicolon, UnknownReference, InvalidCharacterReference, MissingDoctypeName, InvalidDoctype, EofInDoctype, CellWithoutRow, ContentAfterBody, DoctypeInForeignContent, EndTagBr, EofInTemplate, EofWithOpenElements, FormInTable, FormattingElementNotOpen, FormattingElementOutOfScope, FosterParentedContent, HeadContentAfterHead, HiddenInputInTable, HtmlStartTagInForeignContent, MismatchedHeadingEnd, MisnestedEndTag, MisnestedFormatting, MissingDoctype, NestedAnchor, NestedButton, NestedForm, NestedHeading, NestedNobr, NestedTable, NonConformingDoctype, NonVoidHtmlElementStartTagWithTrailingSolidus, TableContentInSelect, UnexpectedBodyEnd, UnexpectedBodyStart, UnexpectedCellEnd, UnexpectedColEnd, UnexpectedDoctype, UnexpectedEndTag, UnexpectedForeignEndTag, UnexpectedFormEnd, UnexpectedFramesetContent, UnexpectedHeadStart, UnexpectedHeadingEnd, UnexpectedOptgroupEnd, UnexpectedOptionEnd, UnexpectedPEnd, UnexpectedRowEnd, UnexpectedRowToken, UnexpectedSelectContent, UnexpectedSelectEnd, UnexpectedSelectToken, UnexpectedTableElement, UnexpectedTableEnd, UnexpectedTableEndTag, UnexpectedTableSectionEnd, UnexpectedTableSectionToken, UnexpectedTemplateEnd, UnexpectedTemplateToken, InvalidHtml]
}
