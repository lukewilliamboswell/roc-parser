## GENERATED by scripts/markdown/gen_entities.py from the HTML5 named character
## references (https://html.spec.whatwg.org/entities.json). Do not edit by hand.
MarkdownEntities :: [].{

	## Decode an entity name (without `&` and `;`) to its replacement text.
	lookup : List(U8) -> Try(List(U8), [NotFound])
	lookup = |name| {
		var $low = 0
		var $high = offsets.len()
		var $found = Err(NotFound)
		while $low < $high {
			middle = ($low + $high) // 2
			start = (offsets.get(middle) ?? 0).to_u64()
			match compare_name(name, start) {
				Before => { $high = middle }
				After => { $low = middle + 1 }
				Same => {
					$found = Ok(value_at(start + name.len() + 1))
					$low = $high
				}
			}
		}
		$found
	}
}

## Order `name` against the NUL-terminated record name at `start`.
compare_name : List(U8), U64 -> [Before, Same, After]
compare_name = |name, start| {
	var $index = 0
	var $result = Same
	var $comparing = Bool.True
	while $comparing {
		other = data.get(start + $index) ?? 0
		mine = if $index < name.len() (name.get($index) ?? 0) else 0
		if mine < other {
			$result = Before
			$comparing = Bool.False
		} else if mine > other {
			$result = After
			$comparing = Bool.False
		} else if mine == 0 {
			$comparing = Bool.False
		} else {
			$index = $index + 1
		}
	}
	$result
}

value_at : U64 -> List(U8)
value_at = |start| {
	var $end = start
	while (data.get($end) ?? 0) != 0 {
		$end = $end + 1
	}
	data.sublist({ start, len: $end - start })
}

